# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# runtime data written by the admin panel — visitor messages and view counts
# should not end up in the repo. Content JSON (profile/links/news/…) is tracked.
/data/messages.json
/data/stats.json

# leftovers from the atomic write in src/lib/store.ts
/data/*.tmp

# photos uploaded through /admin (the 47 seed photos stay tracked)
/public/gallery/upload-*
